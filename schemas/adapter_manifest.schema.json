{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rightlyfound/semantic-router-cache/blob/main/schemas/adapter_manifest.schema.json",
  "title": "Semantic OS Adapter Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "adapter_id",
    "created_at",
    "source_fingerprint",
    "target_fingerprint",
    "mapping_policy",
    "dependency_versions",
    "validation_authority",
    "models_used",
    "synthesis_mode",
    "context_references",
    "fixture_ids",
    "test_result",
    "lossiness",
    "redactions",
    "status"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "adapter_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "minLength": 3},
    "created_at": {"type": "string", "format": "date-time"},
    "source_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
    "target_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
    "mapping_policy": {"type": "object"},
    "dependency_versions": {"type": "object", "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}},
    "validation_authority": {"type": "string", "minLength": 1},
    "models_used": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "synthesis_mode": {"type": "string", "enum": ["single_pass", "two_pass", "repair_attempt"]},
    "context_references": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "fixture_ids": {"type": "array", "items": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"}},
    "test_result": {"type": "string", "enum": ["passed", "failed", "skipped"]},
    "lossiness": {"type": "array", "items": {"type": "string"}},
    "redactions": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["proposed", "valid", "stale", "invalid", "deprecated"]},
    "generator": {"type": "object"},
    "canonicalization_version": {"type": "string", "minLength": 1}
  }
}
